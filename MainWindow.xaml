<Window x:Class="RazerEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Razer Tartarus Profile Editor"
        Height="700" Width="580"
        MinHeight="600" MinWidth="500"
        Background="#1A1A1A"
        Foreground="White">

    <Window.Resources>
        <!-- Base key button template -->
        <ControlTemplate x:Key="KeyBtnTemplate" TargetType="Button">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#3A3A3A"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#44D62C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#222"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Default (unmapped) key button -->
        <Style x:Key="KeyBtnDefault" TargetType="Button">
            <Setter Property="Width" Value="86"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource KeyBtnTemplate}"/>
        </Style>

        <!-- Remapped key button (green border) -->
        <Style x:Key="KeyBtnRemapped" BasedOn="{StaticResource KeyBtnDefault}" TargetType="Button">
            <Setter Property="BorderBrush" Value="#44D62C"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Unsupported assignment (non-SINGLEKEY) -->
        <Style x:Key="KeyBtnUnsupported" BasedOn="{StaticResource KeyBtnDefault}" TargetType="Button">
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>

        <!-- Toolbar button -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#44D62C"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ── Toolbar ── -->
        <Border DockPanel.Dock="Top" Background="#111" Padding="12,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Profile:" Foreground="#888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProfileCombo" Width="160" Height="30"
                          SelectionChanged="ProfileCombo_SelectionChanged"/>

                <TextBlock Text="Layer:" Foreground="#888" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="LayerCombo" Width="64" Height="30"
                          SelectionChanged="LayerCombo_SelectionChanged"/>

                <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource ToolBtn}"
                        Margin="16,0,0,0" Click="SaveBtn_Click"/>

                <TextBlock x:Name="ActiveLabel" Foreground="#44D62C" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBlock x:Name="StatusLabel" Foreground="#888"
                           VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"/>
            </WrapPanel>
        </Border>

        <!-- ── Content ── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel" Margin="20,12,20,20">

                <!-- MAIN KEYS -->
                <TextBlock Text="MAIN KEYS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                <Grid x:Name="MainGrid" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Buttons added in code-behind -->
                </Grid>

                <!-- THUMB -->
                <TextBlock Text="THUMB" Style="{StaticResource SectionLabel}"/>
                <StackPanel x:Name="ThumbPanel" Orientation="Horizontal"/>

                <!-- D-PAD -->
                <TextBlock Text="D-PAD" Style="{StaticResource SectionLabel}"/>
                <Grid x:Name="DpadGrid" HorizontalAlignment="Left"
                      Width="278" Height="148">
                    <!-- Buttons placed absolutely -->
                </Grid>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
